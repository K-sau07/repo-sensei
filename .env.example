# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------- environment
SENSEI_ENV=dev

# ---------------------------------------------------------------- local infra (infra/docker-compose.yml)
SENSEI_PG_USER=sensei
SENSEI_PG_PASSWORD=sensei
SENSEI_PG_PORT=55432
SENSEI_REDIS_PORT=56379
SENSEI_S3_PORT=9000

# ---------------------------------------------------------------- database
# app role (row-level security enforced), schema owner (migrations), system role (bypasses RLS)
SENSEI_DATABASE_URL=postgresql+asyncpg://sensei_app:sensei_app@localhost:55432/sensei
SENSEI_DATABASE_MIGRATE_URL=postgresql+asyncpg://sensei:sensei@localhost:55432/sensei
SENSEI_DATABASE_SYSTEM_URL=postgresql+asyncpg://sensei_system:sensei_system@localhost:55432/sensei
SENSEI_DATABASE_TEST_NAME=sensei_test
# passwords given to the sensei_app / sensei_system roles when migration 0002 creates them
SENSEI_DATABASE_APP_PASSWORD=sensei_app
SENSEI_DATABASE_SYSTEM_PASSWORD=sensei_system

# ---------------------------------------------------------------- redis
SENSEI_REDIS_URL=redis://localhost:56379/0

# ---------------------------------------------------------------- object storage (SeaweedFS locally, S3/R2 in cloud)
SENSEI_S3_ENDPOINT=http://localhost:9000
SENSEI_S3_ACCESS_KEY=sensei
SENSEI_S3_SECRET_KEY=sensei-dev-secret
SENSEI_S3_REGION=us-east-1
SENSEI_S3_BUCKET_SNAPSHOTS=sensei-snapshots
SENSEI_S3_BUCKET_ARTIFACTS=sensei-artifacts

# ---------------------------------------------------------------- auth
# base64 of 32 random bytes; generate with:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# The value below is the public dev key and is rejected outside dev/test.
SENSEI_AUTH_TOKEN_ENCRYPTION_KEY=cmVwby1zZW5zZWktZGV2LWtleS1ub3QtYS1zZWNyZXQ=

# ---------------------------------------------------------------- github app (sign-in + repo access)
# Create a GitHub App (see the setup notes) and fill these in. Keep the private key file outside
# the repository.
SENSEI_GITHUB_APP_ID=
SENSEI_GITHUB_APP_SLUG=
SENSEI_GITHUB_CLIENT_ID=
SENSEI_GITHUB_CLIENT_SECRET=
SENSEI_GITHUB_PRIVATE_KEY_PATH=
# Or the PEM itself (hosts that only take env vars); wins over the path when both are set.
# SENSEI_GITHUB_PRIVATE_KEY=
SENSEI_GITHUB_WEBHOOK_SECRET=
# Local webhooks: a https://smee.io channel, also set as the app's webhook URL; `make webhooks`.
SMEE_URL=
# App settings on GitHub: Callback URL <web origin>/api/v1/auth/github/callback, Setup URL
# <web origin>/api/v1/github/setup with "Redirect on update" on. Leave "Request user authorization
# during installation" off: it replaces the Setup URL, which links installs to orgs.
# Permissions: Contents, Metadata, Pull requests, Issues read; Email addresses read; and
# Members read (organization), so linking an org's installation can check the user is an admin.

# ---------------------------------------------------------------- voyage ai (embeddings, reranking)
# An API key from https://dash.voyageai.com/api-keys. An account without a payment method has
# much lower rate limits: lower the two limits below to match (see the Rate Limits page).
SENSEI_VOYAGE_API_KEY=
# SENSEI_VOYAGE_REQUESTS_PER_MINUTE=2000
# SENSEI_VOYAGE_TOKENS_PER_MINUTE=3000000
# SENSEI_VOYAGE_RERANK_MODEL=rerank-3
# SENSEI_VOYAGE_RERANK_LITE_MODEL=rerank-3-lite

# ---------------------------------------------------------------- anthropic (claude)
# An API key from https://platform.claude.com/settings/keys (summaries, routing, reranking, answers).
SENSEI_ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- api
# Behind a proxy that sets the client's address itself (Fly.io: fly-client-ip). Leave unset
# locally; forwarded headers are never trusted.
# SENSEI_API_CLIENT_IP_HEADER=
# Memory (MB, per API process) for decoded Merkle trees and constellations kept for browsing.
# SENSEI_API_TREE_CACHE_MB=96
# SENSEI_API_CONSTELLATION_CACHE_MB=64

# ---------------------------------------------------------------- workers (celery)
# The broker and task results default to databases 1 and 2 of SENSEI_REDIS_URL.
# SENSEI_WORKER_BROKER_URL=
# SENSEI_WORKER_RESULT_BACKEND=

# ---------------------------------------------------------------- ingest
# Where workers keep cloned repositories (default ~/.cache/repo-sensei/repos), its disk budget,
# the largest repository accepted (checked out) and the most files indexed per repository.
# SENSEI_INGEST_CACHE_DIR=
# SENSEI_INGEST_CACHE_MAX_BYTES=53687091200
# SENSEI_INGEST_MAX_CHECKOUT_BYTES=2147483648
# SENSEI_INGEST_MAX_FILES=250000
# Where the API unpacks snapshots to serve files (default ~/.cache/repo-sensei/snapshots), and its budget.
# SENSEI_INGEST_SNAPSHOT_CACHE_DIR=
# SENSEI_INGEST_SNAPSHOT_CACHE_MAX_BYTES=21474836480

# ---------------------------------------------------------------- search
# Hybrid search's fusion weights (a leg's times its query's origin's; 0 leaves a leg out).
# SENSEI_SEARCH_LEX_CODE=1.0
# SENSEI_SEARCH_SYM=1.2
# SENSEI_SEARCH_GREP=1.0
# SENSEI_SEARCH_LAYER_BOOST=1.2

# Usage pricing: a JSON price table; leave empty for the built-in table
SENSEI_PRICING_TABLE_PATH=
# What one org may spend on models in a calendar month (UTC), in USD
# SENSEI_PRICING_ORG_MONTHLY_CAP_USD=25
