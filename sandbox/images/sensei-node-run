#!/bin/sh
# sensei-node-run <project> <command...>
# The snapshot at /src is read-only and test tools write (caches, snapshots): a copy of it goes
# to /work/src (in memory, size-capped), the installed node_modules are copied into <project>,
# and the command runs there.
set -eu
project="$1"
shift
mkdir -p /work/src
tar -C /src --exclude=node_modules -cf - . | tar -C /work/src -xf -
if [ -d /opt/deps/node_modules ]; then
    cp -R /opt/deps/node_modules "/work/src/$project/node_modules"
fi
cd "/work/src/$project"
exec "$@"
