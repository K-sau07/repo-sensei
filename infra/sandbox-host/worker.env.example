# /etc/repo-sensei/worker.env on the sandbox host (root:sensei, 0640). The same values as the
# Fly workers' secrets: never commit the real file.
SENSEI_ENV=production
SENSEI_DATABASE_URL=
SENSEI_DATABASE_SYSTEM_URL=
SENSEI_REDIS_URL=
SENSEI_WORKER_BROKER_URL=
SENSEI_WORKER_RESULT_BACKEND=
SENSEI_S3_ENDPOINT=
SENSEI_S3_REGION=auto
SENSEI_S3_ACCESS_KEY=
SENSEI_S3_SECRET_KEY=
SENSEI_S3_BUCKET_SNAPSHOTS=
SENSEI_S3_BUCKET_ARTIFACTS=
SENSEI_AUTH_TOKEN_ENCRYPTION_KEY=
SENSEI_GITHUB_APP_ID=
SENSEI_GITHUB_PRIVATE_KEY=
SENSEI_ANTHROPIC_API_KEY=
SENSEI_VOYAGE_API_KEY=
SENSEI_SENTRY_DSN=
