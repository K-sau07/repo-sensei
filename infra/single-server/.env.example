# repo-sensei on one server: copy to infra/single-server/.env (setup.sh does it, generating the
# secrets marked "generated"). Never commit .env. Hostnames are the compose services'.

SENSEI_ENV=production
# The site's address (Cloudflare Tunnel's public hostname), no trailing slash.
SENSEI_WEB_ORIGIN=https://sensei.example.com
# Only you can sign in: your GitHub login (comma-separate more).
SENSEI_AUTH_ALLOWED_LOGINS=your-github-login

# ---------------------------------------------------------------- generated by setup.sh
SENSEI_PG_PASSWORD=
SENSEI_DATABASE_APP_PASSWORD=
SENSEI_DATABASE_SYSTEM_PASSWORD=
SENSEI_AUTH_TOKEN_ENCRYPTION_KEY=
SENSEI_S3_ACCESS_KEY=
SENSEI_S3_SECRET_KEY=

# ---------------------------------------------------------------- database, redis, storage
# (The passwords come from the generated values above; setup.sh writes them into these URLs.)
SENSEI_DATABASE_URL=postgresql+asyncpg://sensei_app:APP_PASSWORD@postgres:5432/sensei
SENSEI_DATABASE_MIGRATE_URL=postgresql+asyncpg://sensei:PG_PASSWORD@postgres:5432/sensei
SENSEI_DATABASE_SYSTEM_URL=postgresql+asyncpg://sensei_system:SYSTEM_PASSWORD@postgres:5432/sensei
SENSEI_REDIS_URL=redis://redis:6379/0
SENSEI_S3_ENDPOINT=http://s3:8333
SENSEI_S3_REGION=us-east-1
SENSEI_S3_BUCKET_SNAPSHOTS=sensei-snapshots
SENSEI_S3_BUCKET_ARTIFACTS=sensei-artifacts

# ---------------------------------------------------------------- cloudflare tunnel
# Zero Trust → Networks → Tunnels → Create (Cloudflared) → copy the token; then add a public
# hostname (your SENSEI_WEB_ORIGIN's) pointing at http://web:3000.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- backups (optional, recommended)
# A Cloudflare R2 bucket (free up to 10 GB): s3://<bucket>/repo-sensei, an R2 API token's key
# pair, and https://<account id>.r2.cloudflarestorage.com.
WALG_S3_PREFIX=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_ENDPOINT=

# ---------------------------------------------------------------- github app
# Callback URL <origin>/api/v1/auth/github/callback; Setup URL <origin>/api/v1/github/setup
# ("Redirect on update" on); Webhook URL <origin>/api/v1/webhooks/github. Permissions: Contents
# and Pull requests read & write (fixes open pull requests), Metadata, Issues, Email addresses,
# Members (organization) read.
SENSEI_GITHUB_APP_ID=
SENSEI_GITHUB_APP_SLUG=
SENSEI_GITHUB_CLIENT_ID=
SENSEI_GITHUB_CLIENT_SECRET=
SENSEI_GITHUB_WEBHOOK_SECRET=
# The private key: save the .pem GitHub gives you as infra/single-server/github-app.pem (it is
# mounted into the containers; never commit it).
SENSEI_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# ---------------------------------------------------------------- models
SENSEI_ANTHROPIC_API_KEY=
SENSEI_VOYAGE_API_KEY=

# ---------------------------------------------------------------- spend: small, it's yours
SENSEI_LIMITS_GLOBAL_DAILY_SPEND_CAP_USD=2
SENSEI_PRICING_ORG_MONTHLY_CAP_USD=20

# ---------------------------------------------------------------- optional
# Email (invitations, notifications): Resend's free tier, with your domain verified there.
SENSEI_NOTIFY_RESEND_API_KEY=
SENSEI_NOTIFY_EMAIL_FROM=repo-sensei <notifications@example.com>
# Errors: Sentry's free tier.
SENSEI_SENTRY_DSN=

# ---------------------------------------------------------------- the fix stages (on the host)
SENSEI_SANDBOX_RUNTIME=runsc
SENSEI_SANDBOX_REQUIRE_GVISOR=true
